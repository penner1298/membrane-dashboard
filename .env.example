# ==========================================
# Membrane Guard API Environment Variables
# ==========================================

# ------------------------------------------
# 🌐 Agent-Agnostic LLM Provider Models
# ------------------------------------------
# Define the models you want to use. Membrane uses LiteLLM under the hood,
# which supports OpenAI, Anthropic, Gemini, Groq, DeepSeek, Ollama, etc.

# Flash model (fast classification, bouncer firewall, first-pass engagement)
# Suggestions:
# - Gemini (Default): gemini/gemini-2.5-flash
# - OpenAI: openai/gpt-4o-mini
# - Anthropic: anthropic/claude-3-5-haiku
# - Groq (Cloud API): groq/llama3-8b-8192
# - Ollama (Local/Offline): ollama/gemma4
FLASH_MODEL=gemini/gemini-2.5-flash

# Apex model (deep cognitive reasoning, fallback recovery, complex JSON compliance)
# Suggestions:
# - Gemini (Default): gemini/gemini-3.5-flash
# - OpenAI: openai/gpt-4o
# - Anthropic: anthropic/claude-3-5-sonnet
# - DeepSeek: deepseek/deepseek-chat
# - Ollama (Local/Offline): ollama/gemma4:9b
APEX_MODEL=gemini/gemini-3.5-flash

# Embedding model (sub-2ms exact match and semantic edge vector caching)
# Suggestions:
# - Gemini (Default): gemini/text-embedding-004
# - OpenAI: openai/text-embedding-3-small
# - Cohere: cohere/embed-english-v3.0
# - Ollama (Local/Offline): ollama/nomic-embed-text
EMBED_MODEL=gemini/text-embedding-004

# ------------------------------------------
# 🔑 LLM Provider API Keys
# ------------------------------------------
# Provide the API keys matching the models you configured above.
# (If using offline local models like Ollama, no API key is required).

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# ------------------------------------------
# 🛡️ Membrane Core Configurations
# ------------------------------------------
# Optional: License key validation (Use 'test_license_key' for local dev)
MEMBRANE_LICENSE_KEY=test_license_key

# Optional: PostgreSQL Database for storing logs, ledger, & semantic cache
DATABASE_URL=
